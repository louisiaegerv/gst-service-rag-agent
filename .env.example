# Vector store — Qdrant Cloud (free tier cluster, see qdrant.io)
QDRANT_CLUSTER_ENDPOINT=https://xxxx.aws.cloud.qdrant.io
QDRANT_API_KEY=xxxx
QDRANT_COLLECTION_NAME=gst_manuals

# Embeddings — OpenAI text-embedding-3-small (used at ingest time and query time)
OPENAI_API_KEY=xxxx

# LLM generation + tool-call routing — OpenRouter (model-agnostic; lets us target Claude specifically)
OPENROUTER_API_KEY=xxxx

# NHTSA Recalls API (api.nhtsa.gov) requires no API key — called directly, no env var needed.
